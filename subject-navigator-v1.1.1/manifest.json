{
  "manifest_version": 3,
  "name": "Subject Navigator for swisscovery",
  "version": "1.1.1",
  "description": "Multilingual hierarchical navigation of controlled subject headings (Nuovo Soggettario BNCF, GND, RAMEAU, LCSH) and classification (UDC, DDC) for the swisscovery/SLSP and reperio library catalogs.",
  "minimum_chrome_version": "102",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://swisscovery.ch/*",
    "https://*.swisscovery.ch/*",
    "https://*.swisscovery.slsp.ch/*",
    "https://*.swisscovery.org/*",
    "https://reperio.usi.ch/*",
    "https://explore.lib.unige.ch/*",
    "https://www.wikidata.org/*",
    "https://query.wikidata.org/*",
    "https://digitale.bncf.firenze.sbn.it/*",
    "https://vocab.getty.edu/*",
    "https://lobid.org/*",
    "https://www.idref.fr/*",
    "https://data.bnf.fr/*",
    "https://datos.bne.es/*",
    "https://id.loc.gov/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://swisscovery.ch/*",
        "https://*.swisscovery.ch/*",
        "https://*.swisscovery.slsp.ch/*",
        "https://*.swisscovery.org/*",
        "https://reperio.usi.ch/*",
        "https://explore.lib.unige.ch/*"
      ],
      "js": [
        "cs_core.js",
        "cs_index.js",
        "cs_marc.js",
        "cs_class.js",
        "cs_reconcile.js",
        "cs_render.js",
        "cs_main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Subject Navigator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.css",
        "vocab_cdu.json",
        "vocab_cdd.json",
        "vocab_geo.json"
      ],
      "matches": [
        "https://swisscovery.ch/*",
        "https://*.swisscovery.ch/*",
        "https://*.swisscovery.slsp.ch/*",
        "https://*.swisscovery.org/*",
        "https://reperio.usi.ch/*",
        "https://explore.lib.unige.ch/*"
      ]
    }
  ]
}
